# NEAT personal-key desktop mode (configure only the suppliers you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
# Used only with the advanced OpenAI-compatible supplier.
NEAT_ASSISTANT_BASE_URL=

# Hosted shared-service server only
NEAT_SHARED_SERVICE_TOKEN=
NEAT_SHARED_OPENAI_MODEL=gpt-5.6-luna
NEAT_SHARED_DAILY_LIMIT=20
NEAT_SHARED_HOST=127.0.0.1
NEAT_SHARED_PORT=8765

# Desktop clients using the hosted shared service
# Use HTTPS for any non-local deployment.
NEAT_SHARED_SERVICE_URL=http://127.0.0.1:8765
NEAT_SHARED_ACCESS_TOKEN=
